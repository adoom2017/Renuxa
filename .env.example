DATABASE_URL=postgres://renuxa:renuxa@127.0.0.1:5432/renuxa
JWT_SECRET=replace-with-at-least-32-random-characters
BIND_ADDR=0.0.0.0:8080
# Host ports for the local debug Compose stack.
RENUXA_WEB_PORT=3000
RENUXA_API_PORT=8081
RUST_LOG=renuxa_server=info,tower_http=info
VITE_API_URL=http://127.0.0.1:8080/api
WECHAT_ENABLED=true
# Random service token of at least 32 characters, shared by API and gateway.
WECHAT_GATEWAY_TOKEN=
# Internal gateway admin endpoint and stable identity. Compose supplies the URL.
WECHAT_GATEWAY_URL=http://gateway:18765
WECHAT_GATEWAY_ID=renuxa-wechat
# Full multimodal Chat Completions endpoint supporting JSON output.
WECHAT_MODEL_URL=
WECHAT_MODEL_NAME=
WECHAT_MODEL_API_KEY=
WECHAT_OCR_ENABLED=true
WECHAT_OCR_LANG=chi_sim+eng
