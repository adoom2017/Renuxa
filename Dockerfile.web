# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,id=renuxa-npm,target=/root/.npm npm ci

COPY app ./app
COPY desktop ./desktop
COPY public ./public
COPY tsconfig.json vite.desktop.config.ts ./

ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build:desktop-web

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist-desktop /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1
