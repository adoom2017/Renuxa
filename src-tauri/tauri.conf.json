{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renuxa",
  "version": "0.1.0",
  "identifier": "com.renuxa.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build:desktop-web",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "title": "续序 Renuxa",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://*.mzstatic.com data:; connect-src 'self' http://127.0.0.1:8080 https://itunes.apple.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.icns"],
    "shortDescription": "续序订阅管理",
    "longDescription": "管理循环订阅、续费提醒、历史账单和多币种支出。"
  }
}
