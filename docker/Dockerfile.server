# syntax=docker/dockerfile:1.7

FROM rust:1.96-bookworm AS build
WORKDIR /app

ENV CARGO_INCREMENTAL=0
ENV CARGO_BUILD_JOBS=1
ARG TARGETARCH

COPY Cargo.toml Cargo.lock ./
COPY server/Cargo.toml ./server/Cargo.toml
COPY src-tauri/Cargo.toml src-tauri/build.rs ./src-tauri/
COPY src-tauri/src ./src-tauri/src
COPY server ./server
COPY im-channel-gateway ./im-channel-gateway

RUN --mount=type=cache,id=renuxa-cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry \
    --mount=type=cache,id=renuxa-cargo-git-${TARGETARCH},target=/usr/local/cargo/git \
    --mount=type=cache,id=renuxa-target-${TARGETARCH},target=/app/target \
    touch server/src/lib.rs server/src/main.rs server/src/bin/worker.rs && \
    cargo build --locked --release -p renuxa-server -p im-channel-gateway --bins && \
    cp /app/target/release/renuxa-server /tmp/renuxa-server && \
    cp /app/target/release/worker /tmp/renuxa-worker && \
    cp /app/target/release/im-channel-gateway /tmp/im-channel-gateway

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl libssl3 tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng && \
    useradd --create-home --uid 10001 renuxa && \
    mkdir -p /var/lib/renuxa-wechat && chown renuxa:renuxa /var/lib/renuxa-wechat && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build /tmp/renuxa-server /usr/local/bin/renuxa-server
COPY --from=build /tmp/renuxa-worker /usr/local/bin/renuxa-worker
COPY --from=build /tmp/im-channel-gateway /usr/local/bin/im-channel-gateway
COPY docker/wechat.toml /etc/renuxa/wechat.toml

USER renuxa
ENV BIND_ADDR=0.0.0.0:8080
EXPOSE 8080
CMD ["renuxa-server"]
