# syntax=docker/dockerfile:1.7

FROM lukemathwalker/cargo-chef:latest-rust-1.98.1-bookworm AS planner
WORKDIR /app

# The desktop crate is not part of the server image. Keep the repository
# workspace unchanged and remove it only inside the build container.
COPY . .
RUN sed -i 's/, "src-tauri"//' Cargo.toml && \
    cargo chef prepare --recipe-path recipe.json

FROM lukemathwalker/cargo-chef:latest-rust-1.98.1-bookworm AS dependencies
WORKDIR /app
ARG TARGETARCH
COPY --from=planner /app/recipe.json recipe.json
RUN --mount=type=cache,id=renuxa-cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=renuxa-cargo-git-${TARGETARCH},target=/usr/local/cargo/git,sharing=locked \
    cargo chef cook --release --recipe-path recipe.json

FROM lukemathwalker/cargo-chef:latest-rust-1.98.1-bookworm AS source
WORKDIR /app
COPY . .
RUN sed -i 's/, "src-tauri"//' Cargo.toml

FROM source AS build-server
ARG TARGETARCH
COPY --from=dependencies /app/target /app/target
RUN --mount=type=cache,id=renuxa-cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=renuxa-cargo-git-${TARGETARCH},target=/usr/local/cargo/git,sharing=locked \
    cargo build --offline --release -p renuxa-server --bins

FROM source AS build-gateway
ARG TARGETARCH
COPY --from=dependencies /app/target /app/target
RUN --mount=type=cache,id=renuxa-cargo-registry-${TARGETARCH},target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=renuxa-cargo-git-${TARGETARCH},target=/usr/local/cargo/git,sharing=locked \
    cargo build --offline --release -p im-channel-gateway --bin im-channel-gateway

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl libssl3 tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng && \
    useradd --create-home --uid 10001 renuxa && \
    mkdir -p /var/lib/renuxa-wechat && chown renuxa:renuxa /var/lib/renuxa-wechat && \
    rm -rf /var/lib/apt/lists/*

COPY --from=build-server /app/target/release/renuxa-server /usr/local/bin/renuxa-server
COPY --from=build-server /app/target/release/worker /usr/local/bin/worker
COPY --from=build-gateway /app/target/release/im-channel-gateway /usr/local/bin/im-channel-gateway
COPY docker/wechat.toml /etc/renuxa/wechat.toml

USER renuxa
ENV BIND_ADDR=0.0.0.0:8080
EXPOSE 8080
CMD ["renuxa-server"]
